+def resolve_low_confidence_grade(
+    classification: Classification, sample: str
+) -> tuple[Classification, str | None]:
+    """Use explicit source evidence for a weak grade guess, otherwise abstain."""
+    if classification.confidences.get("grade_band", 0.0) >= 0.5:
+        return classification, None
+
+    grades = set()
+    for start, end in _EXPLICIT_GRADE.findall(sample):
+        first = start.upper()
+        grades.add(f"{first}-{end}" if end else first)
+
+    data = classification.model_dump(mode="json")
+    confidences = dict(data.get("confidences") or {})
+    if len(grades) == 1:
+        data["grade_band"] = grades.pop()
+        confidences["grade_band"] = 0.99
+        reason = "recovered from one explicit grade label in the source"
+    else:
+        data["grade_band"] = "Unknown"
+        confidences["grade_band"] = 0.0
+        reason = "abstained because the source has no unique explicit grade label"
+    data["confidences"] = confidences
+    return Classification.model_validate(data), reason
+
