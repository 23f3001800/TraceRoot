diff --git a/app/payment_gateway.py b/app/payment_gateway.py
new file mode 100644
index 0000000..fd43835
--- /dev/null
+++ b/app/payment_gateway.py
@@ -0,0 +1,11 @@
+import os
+from app.core import logger
+
+SUPPORTED_REGION = "us-east-1"
+
+def charge(amount):
+    region = os.environ.get("PAYMENTS_REGION", "us-east-1")
+    if region != SUPPORTED_REGION:
+        logger.error("Payment gateway rejected configured region", extra={"payment_region": region})
+        raise RuntimeError("Payment gateway authorization failed")
+    return {"status": "completed", "amount": str(amount)}
